{
    "$schema": "https://raw.githubusercontent.com/EmmyLuaLs/emmylua-analyzer-rust/refs/heads/main/crates/emmylua_code_analysis/resources/schema.json",
    "runtime": {
        "version": "LuaJIT"
    },
    "diagnostics": {
        "globals": [
            "vim"
        ],
        "enables": [
            "missing-global-doc"
        ]
    },
    "workspace": {
        "library": [
            "$VIMRUNTIME",
            "$HOME/.local/share/nvim/lazy/luvit-meta/library/uv.lua"
        ],
        "ignoreGlobs": [
            "**/*_spec.lua"
        ],
        "ignoreDir": [
            "tests/manual/deps/",
            "tests/data/deps/",
            "deps"
        ]
    }
}
